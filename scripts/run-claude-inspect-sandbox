#!/usr/bin/env bash
set -euo pipefail

fail() {
  printf 'run-claude-inspect-sandbox: %s\n' "$1" >&2
  exit 1
}

realpath_or_raw() {
  local target="$1"

  if command -v realpath >/dev/null 2>&1; then
    realpath "$target" 2>/dev/null || printf '%s\n' "$target"
    return
  fi

  printf '%s\n' "$target"
}

readonly HOST_HOME="${HOME:-}"

if (( $# < 6 )); then
  fail "expected: <run-workdir> <inspect-workdir> <kubeconfig-path> <agent-child-path> <claude-binary> -- <claude-args...>"
fi

run_workdir="$1"
inspect_workdir="$2"
kubeconfig_path="$3"
agent_child_path="$4"
claude_binary="$5"
shift 5

if [[ "${1:-}" != "--" ]]; then
  fail "missing -- before claude args"
fi
shift

command -v bwrap >/dev/null 2>&1 || fail "bubblewrap is required"
[[ -n "$HOST_HOME" ]] || fail "HOME is required"
[[ -d "$run_workdir" ]] || fail "run workdir is not a directory"
[[ -d "$inspect_workdir" ]] || fail "inspect workdir is not a directory"
[[ -f "$kubeconfig_path" ]] || fail "kubeconfig is not a file"
[[ -n "$agent_child_path" ]] || fail "AGENT_CHILD_PATH is required"

claude_path="$(command -v "$claude_binary" || true)"
[[ -n "$claude_path" && -x "$claude_path" ]] || fail "claude binary is not executable"
claude_real_path="$(realpath_or_raw "$claude_path")"
[[ -x "$claude_real_path" ]] || fail "claude resolved path is not executable"
claude_bind_root="$(dirname "$claude_real_path")"

tentix_codex_root="${HOST_HOME}/.local/share/tentix-codex"
[[ -d "$tentix_codex_root" ]] || fail "tentix codex runtime directory is missing"

sandbox_args=(
  --die-with-parent
  --unshare-pid
  --proc /proc
  --dev /dev
  --tmpfs /tmp
  --dir "$HOST_HOME"
  --dir "${HOST_HOME}/.local"
  --dir "${HOST_HOME}/.local/share"
  --ro-bind "$claude_bind_root" "$claude_bind_root"
  --ro-bind "$tentix_codex_root" "$tentix_codex_root"
  --bind "$run_workdir" "$run_workdir"
  --ro-bind "$inspect_workdir" "$inspect_workdir"
  --ro-bind "$kubeconfig_path" "$kubeconfig_path"
  --ro-bind /usr /usr
  --ro-bind /bin /bin
  --ro-bind /lib /lib
  --ro-bind-try /lib64 /lib64
  --ro-bind-try /etc/ssl /etc/ssl
  --ro-bind-try /etc/pki /etc/pki
  --ro-bind-try /etc/ca-certificates /etc/ca-certificates
  --ro-bind-try /etc/resolv.conf /etc/resolv.conf
  --ro-bind-try /etc/nsswitch.conf /etc/nsswitch.conf
  --ro-bind-try /etc/hosts /etc/hosts
  --setenv HOME "$HOST_HOME"
  --setenv TMPDIR /tmp
  --chdir "$run_workdir"
)

IFS=':' read -r -a child_path_entries <<< "$agent_child_path"
for path_entry in "${child_path_entries[@]}"; do
  [[ -n "$path_entry" && -d "$path_entry" ]] || continue
  case "$path_entry" in
    /usr|/usr/*|/bin|/bin/*|/lib|/lib/*|/lib64|/lib64/*)
      continue
      ;;
    *)
      sandbox_args+=(--ro-bind "$path_entry" "$path_entry")
      ;;
  esac
done

exec bwrap "${sandbox_args[@]}" "$claude_real_path" "$@"

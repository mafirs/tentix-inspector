# AI Configuration (Generic - Vendor-Agnostic)
AI_API_KEY=xxx
AI_BASE_URL=https://aiproxy.usw.sealos.io/v1
AI_MODEL=gemini-2.5-flash-lite
AI_ENABLED=true
TOOLS_DESC_OVERRIDE_FILE=./config/tools-override.json
TENTIX_INSPECTOR_API_KEY=111
# tentix-inspector concurrency guard
# MAX_CONCURRENT_INSPECTIONS=6
# MAX_PENDING_INSPECTIONS=12
# PENDING_INSPECTION_TIMEOUT_MS=15000
# NODE_ENV=production， NODE_ENV=development

# Codex 自动诊断入口（/api/codex-inspect）配置
# 作用：指定服务调用的 Codex CLI 可执行文件；填写建议：默认使用 PATH 中的 codex 即可，只有部署机安装在非标准路径时再填写绝对路径。
CODEX_BIN=codex
# 作用：指定 Codex 诊断可读取的资料目录，用于放 Sealos 源码、知识库和操作守则；填写建议：填写服务运行用户可读的绝对路径，并保持该目录只读，不要指向每次运行的临时目录。
CODEX_INSPECT_WORKDIR=/home/devbox/.codex/skills/tentix-Sealos-ticket/knowledge
# 作用：指定 Codex 的配置、登录态、日志、会话和 skills 根目录；填写建议：填写服务运行用户专用的 CODEX_HOME 绝对路径，并提前用同一用户完成 Codex 登录和 skill 安装。
CODEX_HOME=/home/devbox/.codex

# 作用：指定 /api/codex-inspect 每次请求要显式触发的 Codex skill 名称；填写建议：填写已安装在 CODEX_HOME 下、专门处理 Tentix 工单诊断的 skill 名称，不要填写带 $ 前缀的形式。
CODEX_INSPECT_SKILL=tentix-sealos-ticket

# 作用：控制 Codex 子进程的沙箱模式；填写建议：优先使用默认 workspace-write，只有部署机 sandbox 无法启动且已评估风险时才改为 danger-full-access，可选值为 read-only、workspace-write、danger-full-access。
CODEX_SANDBOX=danger-full-access

# 作用：在 CODEX_SANDBOX=workspace-write 时允许 Codex 工作区访问网络，以便 ByAgent 查询 Kubernetes API；填写建议：需要集群诊断时保持 true，只有确认不需要网络访问时才设为 false。
CODEX_WORKSPACE_NETWORK_ACCESS=true

# 作用：控制单次 Codex 诊断最长运行时间，超时后会终止子进程并返回降级文本；填写建议：按工单复杂度设置毫秒值，默认 600000 表示 10 分钟，不建议设置过小。
CODEX_RUN_TIMEOUT_MS=600000

# 作用：限制同时运行的 Codex 诊断子进程数量，避免长耗时诊断拖垮宿主机；填写建议：默认 1 最稳妥，只有确认 CPU、内存和 Codex 配额充足时再调大。
CODEX_MAX_CONCURRENT_RUNS=1

# 作用：限制 Codex 诊断并发满载后的等待队列长度；填写建议：默认 4 可吸收短时突发，若希望满载时快速返回繁忙文本可设为 0。
CODEX_MAX_PENDING_RUNS=4

# 作用：控制请求在 Codex 等待队列里最多等待多久，超时后返回繁忙降级文本；填写建议：填写毫秒值，默认 30000 表示 30 秒，可按 Tentix 工作流可接受等待时间调整。
CODEX_PENDING_TIMEOUT_MS=30000

# 作用：限制服务日志中记录的 Codex 命令输出摘要长度，避免日志过长或误记录大量诊断内容；填写建议：默认 1000 足够定位常见失败，排障时可临时调大，避免长期设置过高。
CODEX_OUTPUT_TRUNCATE_CHARS=1000

# 作用：控制 Codex 子进程可见的 PATH，只暴露本项目安全命令目录和基础系统命令，避免 Codex 直接调用原生 kubectl；填写建议：推荐 /home/devbox/.local/share/tentix-codex/bin:/usr/local/bin:/usr/bin:/bin，其中第一段只放 kubectl-ByCodex-READONLY，不要设置为 /home/devbox/.local/bin。
CODEX_CHILD_PATH=/home/devbox/.local/share/tentix-codex/bin:/usr/local/bin:/usr/bin:/bin

#AGENT=claude/codex